# Oasis API — copy to .env and fill in. Never commit the real file.

PORT_API=3013
PORT_BATCH=3014
MONGO_DEV=
MONGO_PROD=
SECRET_TOKEN=

# ---- Sessions -------------------------------------------------------------
# Access tokens are short-lived now; the refresh cookie carries the session.
# Anything longer than a few minutes re-creates the problem refresh tokens
# exist to solve, because an access token cannot be revoked.
ACCESS_TOKEN_TTL=15m
# How long a login may be kept alive by refreshing, without signing in again.
REFRESH_TOKEN_TTL_DAYS=30

# Origins allowed to send credentials. Comma-separated, exact scheme+host+port.
# Required in production, where a plaintext http:// entry fails the boot.
CORS_ORIGINS=http://localhost:3011
# Set in production only, so the cookie is shared across one registrable domain
# (e.g. .oasis.space covers oasis.space and api.oasis.space). Leave blank in
# development: a host-only cookie on localhost already reaches both ports,
# because cookies ignore the port.
COOKIE_DOMAIN=

# ---- Phone verification (optional) ----------------------------------------
# Leave SMS_PROVIDER blank and the whole flow reports itself unavailable:
# getAuthCapabilities.smsVerification is false, the sign-up page skips the
# verification step, and requestPhoneCode refuses instead of pretending.
# No provider delivers production SMS free — see docs/auth-upgrade.md.
SMS_PROVIDER=
SMS_SENDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
PHONE_DEFAULT_COUNTRY_CODE=82

# ---- Optional sign-in providers -------------------------------------------
# Blank means the provider is reported unavailable and no button is rendered.
# Secrets stay here; only the bot name and app id are ever sent to a browser.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---- AI assistant (optional) ----------------------------------------------
# Blank means generation is off: getAssistantCapabilities.generation is false
# and the assistant answers from the records it read, marked as not generated.
# It never fabricates a model answer. See docs/ai-assistant.md in the client.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
